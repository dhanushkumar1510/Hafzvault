# Copy to .env (never commit it). Restart Expo with `npx expo start -c` after changing.
# Base URL of the Django server WITHOUT /api and without a trailing slash.
# Android emulator + local Django:   http://10.0.2.2:8000
# Real phone + local Django (same Wi-Fi): http://YOUR_PC_LAN_IP:8000
# Deployed:                          https://your-service.onrender.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
